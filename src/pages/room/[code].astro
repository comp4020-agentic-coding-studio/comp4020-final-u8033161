---
import "../../styles/global.css";
import { getRoomByCode } from "../../lib/rooms.ts";
import { STEPS } from "../../lib/steps.ts";

const { code } = Astro.params;
const room = code ? await getRoomByCode(code) : undefined;

if (!room) {
  Astro.response.status = 404;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-width=1" />
    <title>{room ? `Room ${room.code}` : "Room not found"}</title>
  </head>
  <body>
    {
      !room ? (
        <main class="not-found">
          <h1>Room not found</h1>
          <p role="alert">No room found with that code.</p>
          <p>
            <a href="/">Back home</a>
          </p>
        </main>
      ) : (
        <main class="room" data-current-step={room.currentStep}>
          <p class="room-code">Room {room.code}</p>
          <p id="countdown-banner" class="countdown-banner" hidden>
            <span id="countdown-visual"></span>
            <span id="countdown-announce" class="visually-hidden" role="status" />
          </p>

          <ol class="ladder">
            {STEPS.map(({ step, label }) => (
              <li class="rung" data-step={step}>
                <div class="rung-head">
                  <span class="lock" aria-hidden="true">
                    🔒
                  </span>
                  <span class="rung-label">
                    {step}. {label}
                  </span>
                </div>
                <div class="draft-slot" />
                {step === room.currentStep ? (
                  <form class="card-form" data-step={step} novalidate>
                    <label for={`body-${step}`}>Your feedback for {label}</label>
                    <textarea
                      id={`body-${step}`}
                      name="body"
                      rows="3"
                      required
                      maxlength="2000"
                      aria-describedby={`status-${step}`}
                    />
                    <button type="submit">Send</button>
                    <p id={`status-${step}`} class="status" role="status" />
                  </form>
                ) : null}
              </li>
            ))}
          </ol>

          {/*
            Astro only scopes an element's CSS (the data-astro-cid-* attribute
            that makes the <style> below actually apply) to markup present in
            this file at build time -- an element built at runtime via
            innerHTML never gets it, which is why the form the old version
            built with a template string rendered unstyled. Elements inside a
            <template>, though, get the attribute baked in right here, so
            cloning this one for a newly-opened rung carries the scoping with
            it. One template serves every rung: the step number and label are
            filled in after cloning.
          */}
          <template id="card-form-template">
            <form class="card-form" novalidate>
              <label>Your feedback</label>
              <textarea rows="3" required maxlength="2000" />
              <button type="submit">Send</button>
              <p class="status" role="status" />
            </form>
          </template>

          {/* Same reasoning: the draft-recovery box is built at runtime
             (it only appears once a rung has actually closed with an
             unsent draft in it), so it also needs to come from a
             same-file template rather than an innerHTML string. */}
          <template id="draft-template">
            <div class="draft-box">
              <p class="draft-title" />
              <p class="draft-text" />
              <div class="draft-actions">
                {/* Text is filled in by JS (renderOfferedDraft) once it
                   knows which rung the draft is being offered into. */}
                <button type="button" class="draft-copy">
                  Copy into next rung
                </button>
                <button type="button" class="draft-dismiss">
                  Dismiss
                </button>
              </div>
            </div>
          </template>
        </main>
      )
    }

    <script>
      const code = window.location.pathname.split("/").pop()!;
      const roomEl = document.querySelector<HTMLElement>(".room");
      const banner = document.getElementById("countdown-banner")!;
      const countdownVisual = document.getElementById("countdown-visual")!;
      const countdownAnnounce = document.getElementById("countdown-announce")!;
      const formTemplate = document.getElementById("card-form-template") as HTMLTemplateElement | null;
      const draftTemplate = document.getElementById("draft-template") as HTMLTemplateElement | null;
      const stepLabels: Record<number, string> = { 1: "Clarify", 2: "Strengths", 3: "Concerns", 4: "Suggestions" };

      // sessionStorage access can throw (private browsing, blocked site
      // data) and a cleared or missing value is normal, not an error -- both
      // are expected outcomes here, not failures, so every access is
      // wrapped rather than left to crash the rest of the page.
      function draftStorageKey(step: number): string {
        return `crit-draft:${code}:${step}`;
      }

      function saveDraft(step: number, text: string): void {
        try {
          if (text) sessionStorage.setItem(draftStorageKey(step), text);
          else sessionStorage.removeItem(draftStorageKey(step));
        } catch {
          // best-effort only; an unsaved draft still survives for as long
          // as this tab stays open, which is the common case
        }
      }

      function loadDraft(step: number): string | null {
        try {
          return sessionStorage.getItem(draftStorageKey(step));
        } catch {
          return null;
        }
      }

      function clearDraft(step: number): void {
        try {
          sessionStorage.removeItem(draftStorageKey(step));
        } catch {
          // nothing to clean up if storage isn't available in the first place
        }
      }

      let countdownInterval: ReturnType<typeof setInterval> | null = null;

      function clearCountdown() {
        if (countdownInterval) {
          clearInterval(countdownInterval);
          countdownInterval = null;
        }
        banner.hidden = true;
        countdownVisual.textContent = "";
        countdownAnnounce.textContent = "";
      }

      // Same remainingMs + local-clock approach as the stage: anchored to
      // this device's own clock at the moment the event arrives, not the
      // server's absolute deadline, so clock drift can't shift the
      // displayed count.
      function startCountdown(pending: { closingStep: number; remainingMs: number }) {
        const alreadyRunning = countdownInterval !== null;
        const label = stepLabels[pending.closingStep] ?? pending.closingStep;
        const deadline = Date.now() + pending.remainingMs;

        function tick() {
          const secondsLeft = Math.max(0, Math.ceil((deadline - Date.now()) / 1000));
          banner.hidden = false;
          countdownVisual.textContent = `${label} closes in ${secondsLeft}s`;
          if (secondsLeft <= 0 && countdownInterval) {
            clearInterval(countdownInterval);
            countdownInterval = null;
          }
        }

        if (countdownInterval) clearInterval(countdownInterval);
        tick();
        countdownInterval = setInterval(tick, 250);
        // Announced once per countdown, not on every 250ms tick -- see the
        // stage page for the same split between a ticking display and a
        // single aria-live sentence.
        if (!alreadyRunning) countdownAnnounce.textContent = `${label} is closing.`;
      }

      function setStatus(status: HTMLElement, text: string, isError: boolean) {
        status.textContent = text;
        status.setAttribute("role", isError ? "alert" : "status");
      }

      function wireForm(form: HTMLFormElement) {
        const step = Number(form.dataset.step);
        const textarea = form.querySelector("textarea")!;
        const status = form.querySelector(".status") as HTMLElement;
        const button = form.querySelector("button")!;

        const draft = loadDraft(step);
        if (draft) textarea.value = draft;

        textarea.addEventListener("input", () => {
          setStatus(status, "", false);
          saveDraft(step, textarea.value);
        });

        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          const body = textarea.value.trim();
          if (!body) {
            setStatus(status, "Please write something before sending.", true);
            return;
          }
          button.disabled = true;
          setStatus(status, "", false);
          try {
            const res = await fetch(`/api/rooms/${code}/cards`, {
              method: "POST",
              headers: { "content-type": "application/json" },
              body: JSON.stringify({ step, body }),
            });
            if (res.status === 409) {
              // The countdown ran out between this tab rendering the form
              // and the submit landing. The textarea is deliberately left
              // alone: nothing here clears it, and the rung-switch handler
              // below is what turns this leftover text into the draft box
              // on whichever rung opens next.
              setStatus(
                status,
                "This rung just closed. Your draft is still here — you can copy it into the next rung.",
                true,
              );
            } else if (!res.ok) {
              setStatus(status, "Couldn't send. Please try again.", true);
            } else {
              textarea.value = "";
              clearDraft(step);
              setStatus(status, "Sent.", false);
            }
          } catch {
            setStatus(status, "Couldn't send. Please try again.", true);
          } finally {
            button.disabled = false;
          }
        });
      }

      document.querySelectorAll<HTMLFormElement>(".card-form").forEach(wireForm);

      function closeForm(step: number): string {
        // Returns whatever was left unsent in the textarea, so the caller
        // can decide what to do with it -- this function's only job is to
        // remove the form and hand back its contents.
        const form = document.querySelector<HTMLFormElement>(`.rung[data-step="${step}"] .card-form`);
        const leftover = form?.querySelector("textarea")?.value.trim() ?? "";
        form?.remove();
        return leftover;
      }

      function openForm(step: number) {
        const rung = document.querySelector(`.rung[data-step="${step}"]`);
        if (!rung || rung.querySelector(".card-form") || !formTemplate) return;
        const form = formTemplate.content.firstElementChild!.cloneNode(true) as HTMLFormElement;
        form.dataset.step = String(step);
        const label = stepLabels[step] ?? String(step);
        form.querySelector("label")!.textContent = `Your feedback for ${label}`;
        const textarea = form.querySelector("textarea")!;
        textarea.id = `body-${step}`;
        form.querySelector("label")!.setAttribute("for", `body-${step}`);
        const status = form.querySelector(".status") as HTMLElement;
        status.id = `status-${step}`;
        textarea.setAttribute("aria-describedby", status.id);
        rung.append(form);
        wireForm(form);
      }

      // ADR 2's promise is that nobody's words disappear, not just that a
      // rejected *submit* keeps its draft (the 409 case above) -- an unsent
      // draft that was never submitted at all, sitting in a rung that
      // closes out from under it, is the same loss. At most one such draft
      // is "offered" at a time: the most recently closed rung's leftover
      // text, not yet copied in or dismissed. It isn't cleared from
      // sessionStorage until it's resolved one way or another, which is
      // what lets the next two rules work.
      let offeredDraft: { forStep: number; text: string } | null = null;

      function clearAllDraftSlots() {
        document.querySelectorAll<HTMLElement>(".draft-slot").forEach((slot) => {
          slot.innerHTML = "";
        });
      }

      // Called every time the open rung changes, so the draft box (if any
      // is still unresolved) always ends up in the *currently open* rung's
      // slot and nowhere else -- never left behind in a rung that just
      // locked. If the open rung turns out to be the very one the draft
      // was written for (the presenter went back), there's nothing to show
      // as a box: that rung's form prefills straight from sessionStorage
      // (see wireForm's loadDraft call), so the text is simply back where
      // it was, editable, with no extra step.
      function renderOfferedDraft(currentStep: number) {
        clearAllDraftSlots();
        if (!offeredDraft) return;
        if (offeredDraft.forStep === currentStep) {
          offeredDraft = null;
          return;
        }

        const slot = document.querySelector(`.rung[data-step="${currentStep}"] .draft-slot`);
        if (!slot || !draftTemplate) return;
        const box = draftTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement;
        const forStep = offeredDraft.forStep;
        const text = offeredDraft.text;
        box.querySelector(".draft-title")!.textContent = `Your unsent ${stepLabels[forStep] ?? forStep} draft`;
        box.querySelector(".draft-text")!.textContent = text;
        const copyButton = box.querySelector(".draft-copy") as HTMLButtonElement;
        copyButton.textContent = `Copy into ${stepLabels[currentStep] ?? currentStep}`;
        copyButton.addEventListener("click", () => {
          const textarea = document.querySelector<HTMLTextAreaElement>(`.rung[data-step="${currentStep}"] textarea`);
          if (textarea) {
            textarea.value = text;
            textarea.dispatchEvent(new Event("input", { bubbles: true }));
            textarea.focus();
          }
          clearDraft(forStep);
          offeredDraft = null;
          clearAllDraftSlots();
        });
        box.querySelector(".draft-dismiss")!.addEventListener("click", () => {
          clearDraft(forStep);
          offeredDraft = null;
          clearAllDraftSlots();
        });
        slot.append(box);
      }

      // A step other than the one currently open that still has a saved
      // draft -- found on a fresh connection (first load, or a reconnect
      // that happened to arrive with no live step-change event of its own
      // in between) so a draft left over from before a refresh is still
      // offered rather than silently stranded in storage.
      function findOrphanedDraftStep(excludeStep: number): number | null {
        for (const step of [1, 2, 3, 4]) {
          if (step !== excludeStep && loadDraft(step)) return step;
        }
        return null;
      }

      function handleStepChange(nextStep: number, closingStep: number) {
        clearCountdown();
        if (nextStep === closingStep) return;
        const leftover = closeForm(closingStep);
        openForm(nextStep);
        if (roomEl) roomEl.dataset.currentStep = String(nextStep);
        if (leftover) offeredDraft = { forStep: closingStep, text: leftover };
        renderOfferedDraft(nextStep);
      }

      // SSE instead of polling. Reconnects (EventSource's own, after a
      // dropped phone network) get a `snapshot` first, so the form for the
      // currently-open rung is always rebuilt from the server's actual
      // state rather than whatever this tab last knew.
      if (roomEl) {
        const source = new EventSource(`/api/rooms/${code}/events`);

        source.addEventListener("snapshot", (event) => {
          const data = JSON.parse((event as MessageEvent).data);
          const currentStep = Number(roomEl.dataset.currentStep);
          if (data.currentStep !== currentStep) {
            handleStepChange(data.currentStep, currentStep);
          } else if (!offeredDraft) {
            // No step change happened on this connection (first load, or a
            // reconnect that landed between step changes), but a draft
            // from an earlier rung can still be sitting in sessionStorage
            // from before a refresh -- offer it rather than leave it
            // silently stranded in storage.
            const orphanedStep = findOrphanedDraftStep(data.currentStep);
            if (orphanedStep !== null) {
              offeredDraft = { forStep: orphanedStep, text: loadDraft(orphanedStep)! };
              renderOfferedDraft(data.currentStep);
            }
          }
          if (data.pending) startCountdown(data.pending);
          else clearCountdown();
        });

        source.addEventListener("step-closing", (event) => {
          startCountdown(JSON.parse((event as MessageEvent).data));
        });

        source.addEventListener("step", (event) => {
          const data = JSON.parse((event as MessageEvent).data);
          const currentStep = Number(roomEl.dataset.currentStep);
          handleStepChange(data.currentStep, currentStep);
        });
      }
    </script>

    <style>
      body {
        padding: 1.25rem;
      }

      .not-found {
        max-width: 24rem;
        margin: 4rem auto;
        text-align: center;
      }

      .room {
        max-width: 28rem;
        margin: 0 auto;
      }

      .room-code {
        color: var(--text-dim);
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.08em;
      }

      .countdown-banner {
        margin: 0.75rem 0 0;
        padding: 0.6rem 0.75rem;
        border-radius: 0.5rem;
        background: color-mix(in srgb, var(--danger) 20%, var(--surface));
        font-weight: 600;
        font-variant-numeric: tabular-nums;
        text-align: center;
      }

      .ladder {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      .rung {
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        padding: 1rem;
        background: var(--surface);
      }

      .rung:has(.card-form) {
        border-color: var(--accent);
        background: var(--surface-raised);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 35%, transparent);
      }

      .rung:not(:has(.card-form)) {
        opacity: 0.6;
      }

      .rung-head {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .rung:has(.card-form) .lock {
        visibility: hidden;
      }

      .rung-label {
        font-weight: 700;
        font-size: 1.1rem;
      }

      .card-form {
        margin-top: 0.75rem;
      }

      .card-form label {
        display: block;
        font-size: 0.85rem;
        color: var(--text-dim);
        margin-bottom: 0.3rem;
      }

      .card-form textarea {
        width: 100%;
        background: var(--bg);
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        padding: 0.6rem;
        resize: vertical;
      }

      .card-form button {
        margin-top: 0.5rem;
        background: var(--accent);
        color: var(--accent-contrast);
        border: none;
        border-radius: 0.5rem;
        padding: 0.6rem 1rem;
        font-weight: 600;
        width: 100%;
      }

      .status {
        min-height: 1.2rem;
        color: var(--text-dim);
        margin: 0.4rem 0 0;
      }

      .status[role="alert"] {
        color: var(--danger);
      }

      .draft-slot:empty {
        display: none;
      }

      .draft-box {
        margin-top: 0.75rem;
        padding: 0.75rem;
        border: 1px dashed var(--accent);
        border-radius: 0.5rem;
        background: var(--bg);
      }

      .draft-title {
        margin: 0 0 0.4rem;
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--text-dim);
      }

      .draft-text {
        margin: 0 0 0.6rem;
        white-space: pre-wrap;
      }

      .draft-actions {
        display: flex;
        gap: 0.5rem;
      }

      .draft-actions button {
        flex: 1;
        border-radius: 0.5rem;
        padding: 0.5rem 0.75rem;
        font-weight: 600;
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--text);
      }

      .draft-copy {
        border-color: var(--accent) !important;
        color: var(--accent) !important;
      }
    </style>
  </body>
</html>
