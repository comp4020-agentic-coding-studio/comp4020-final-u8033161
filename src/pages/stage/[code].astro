---
import "../../styles/global.css";
import { getRoomByCode, listCards, presenterCookieName } from "../../lib/rooms.ts";
import { STEPS } from "../../lib/steps.ts";

const { code } = Astro.params;
const room = code ? await getRoomByCode(code) : undefined;

if (!room) {
  return Astro.redirect("/?error=notfound");
}

const presented = Astro.cookies.get(presenterCookieName(room.code))?.value;
if (!presented || presented !== room.presenterToken) {
  return Astro.redirect("/?error=unauthorized");
}

const allCards = await listCards(room.id);
const cardsByStep = new Map<number, typeof allCards>();
for (const s of STEPS) cardsByStep.set(s.step, []);
for (const card of allCards) cardsByStep.get(card.step)?.push(card);

// DOM order stays 1 (Clarify) -> 4 (Suggestions), so Tab visits the rungs in
// that same order; .ladder is flex-direction: column-reverse so it still
// *looks* like climbing a ladder (4 at the top, 1 at the bottom).
const rungs = STEPS;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-width=1" />
    <title>Stage · {room.code}</title>
  </head>
  <body>
    <header class="top-bar">
      <span class="room-label">Room</span>
      <span class="room-code">{room.code}</span>
    </header>

    <p id="countdown-banner" class="countdown-banner" hidden>
      <span id="countdown-visual"></span>
      <span id="countdown-announce" class="visually-hidden" role="status"></span>
    </p>

    <main class="ladder" data-current-step={room.currentStep}>
      {
        rungs.map(({ step, label }) => {
          const stepCards = cardsByStep.get(step) ?? [];
          return (
            <section class="rung" data-step={step} aria-labelledby={`rung-${step}-label`}>
              <div class="rung-head">
                <button type="button" class="rung-toggle" data-step={step} aria-pressed={step === room.currentStep}>
                  <span class="lock" aria-hidden="true">
                    {step === room.currentStep ? "🔓" : "🔒"}
                  </span>
                  <span id={`rung-${step}-label`} class="rung-label">
                    {step}. {label}
                  </span>
                  <span class="rung-state"></span>
                </button>
              </div>
              <ul class="cards" aria-live={step === room.currentStep ? "polite" : "off"}>
                {stepCards.map((card) => (
                  <li class="card-chip">
                    <span class="card-author">{card.participantName ?? "anonymous"}</span>
                    {card.body}
                  </li>
                ))}
                {stepCards.length === 0 && <li class="empty">No cards yet</li>}
              </ul>
            </section>
          );
        })
      }
    </main>

    <script define:vars={{ code: room.code, initialStep: room.currentStep }}>
      const ladder = document.querySelector(".ladder");
      const banner = document.getElementById("countdown-banner");
      const countdownVisual = document.getElementById("countdown-visual");
      const countdownAnnounce = document.getElementById("countdown-announce");
      const stepLabels = { 1: "Clarify", 2: "Strengths", 3: "Concerns", 4: "Suggestions" };

      let countdownInterval = null;

      function setButtonsDisabled(disabled) {
        for (const button of document.querySelectorAll(".rung-toggle")) {
          button.disabled = disabled;
        }
      }

      function clearCountdown() {
        if (countdownInterval) {
          clearInterval(countdownInterval);
          countdownInterval = null;
        }
        banner.hidden = true;
        countdownVisual.textContent = "";
        countdownAnnounce.textContent = "";
        setButtonsDisabled(false);
      }

      // Drives the "closes in Ns" text from remainingMs (the server's own
      // countdown, re-measured fresh for this event) plus this device's own
      // clock at the moment it arrived -- never a server-absolute
      // deadline, which would need this device's clock to agree with the
      // server's. A few hundred ms of drift is exactly what turned a 10s
      // countdown into a displayed 11s before this.
      function startCountdown(pending) {
        const alreadyRunning = countdownInterval !== null;
        setButtonsDisabled(true);
        const label = stepLabels[pending.closingStep] ?? pending.closingStep;
        const deadline = Date.now() + pending.remainingMs;

        function tick() {
          const secondsLeft = Math.max(0, Math.ceil((deadline - Date.now()) / 1000));
          banner.hidden = false;
          countdownVisual.textContent = `${label} closes in ${secondsLeft}s`;
          if (secondsLeft <= 0 && countdownInterval) {
            clearInterval(countdownInterval);
            countdownInterval = null;
          }
        }

        if (countdownInterval) clearInterval(countdownInterval);
        tick();
        countdownInterval = setInterval(tick, 250);
        // Announced once, when the countdown actually starts (or this tab
        // joins one already in progress) -- not on every 250ms tick, which
        // would have a screen reader repeat the same sentence ten times a
        // second. countdownAnnounce is a separate aria-live node from the
        // visibly-ticking text for exactly this reason.
        if (!alreadyRunning) countdownAnnounce.textContent = `${label} is closing.`;
      }

      function applyCurrentStep(step) {
        ladder.dataset.currentStep = String(step);
        for (const button of document.querySelectorAll(".rung-toggle")) {
          const isOpen = Number(button.dataset.step) === step;
          button.setAttribute("aria-pressed", String(isOpen));
          button.closest(".rung").classList.toggle("is-open", isOpen);
          button.closest(".rung").classList.toggle("is-locked", !isOpen);
          button.querySelector(".lock").textContent = isOpen ? "🔓" : "🔒";
        }
      }

      applyCurrentStep(initialStep);

      for (const button of document.querySelectorAll(".rung-toggle")) {
        button.addEventListener("click", async () => {
          if (button.disabled) return;
          const step = Number(button.dataset.step);
          if (step === Number(ladder.dataset.currentStep)) return;
          try {
            const res = await fetch(`/api/rooms/${code}/step`, {
              method: "POST",
              headers: { "content-type": "application/json" },
              body: JSON.stringify({ step }),
            });
            // 202 means the countdown started; the step-closing event this
            // tab receives over its own SSE connection drives the banner.
            // A 409 means another change is already closing -- nothing to
            // do here beyond what that event already shows.
            if (!res.ok && res.status !== 409) throw new Error("step change failed");
          } catch {
            // Left as-is; the rung the server still thinks is open stays visibly open.
          }
        });
      }

      function renderCards(step, cards) {
        const list = document.querySelector(`.rung[data-step="${step}"] .cards`);
        if (!list) return;
        list.textContent = "";
        if (cards.length === 0) {
          const empty = document.createElement("li");
          empty.className = "empty";
          empty.textContent = "No cards yet";
          list.append(empty);
          return;
        }
        for (const card of cards) {
          list.append(renderCardChip(card));
        }
      }

      function renderCardChip(card) {
        const item = document.createElement("li");
        item.className = "card-chip";
        const author = document.createElement("span");
        author.className = "card-author";
        author.textContent = card.participantName ?? "anonymous";
        item.append(author, document.createTextNode(card.body));
        return item;
      }

      function renderAll(currentStep, cards) {
        applyCurrentStep(currentStep);
        const byStep = new Map();
        for (const card of cards) {
          if (!byStep.has(card.step)) byStep.set(card.step, []);
          byStep.get(card.step).push(card);
        }
        for (let step = 1; step <= 4; step++) {
          renderCards(step, byStep.get(step) ?? []);
        }
      }

      function appendCard(card) {
        const list = document.querySelector(`.rung[data-step="${card.step}"] .cards`);
        if (!list) return;
        const empty = list.querySelector(".empty");
        if (empty) empty.remove();
        list.append(renderCardChip(card));
      }

      // SSE: one persistent connection per tab instead of polling every few
      // seconds. EventSource reconnects on its own after a dropped network;
      // every connection (first load or reconnect) gets a `snapshot` event
      // first, so a reconnecting tab redraws from the server's current
      // truth rather than trying to replay whatever it missed.
      const source = new EventSource(`/api/rooms/${code}/events`);

      source.addEventListener("snapshot", (event) => {
        const data = JSON.parse(event.data);
        renderAll(data.currentStep, data.cards);
        // A tab that connects (or reconnects) mid-countdown has to join it
        // in progress, not wait for the next step-closing broadcast -- this
        // is what makes a presenter's own page refresh mid-countdown safe.
        if (data.pending) startCountdown(data.pending);
        else clearCountdown();
      });

      source.addEventListener("card", (event) => {
        appendCard(JSON.parse(event.data));
      });

      source.addEventListener("step-closing", (event) => {
        startCountdown(JSON.parse(event.data));
      });

      source.addEventListener("step", (event) => {
        const data = JSON.parse(event.data);
        clearCountdown();
        applyCurrentStep(data.currentStep);
      });
    </script>

    <style>
      :root {
        --rung-height: clamp(4.5rem, 9vh, 7rem);
      }

      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .top-bar {
        display: flex;
        align-items: baseline;
        gap: 1rem;
        padding: clamp(0.75rem, 2vh, 1.5rem) clamp(1rem, 3vw, 3rem);
        border-bottom: 1px solid var(--border);
      }

      .room-label {
        color: var(--text-dim);
        font-size: clamp(1rem, 1.6vw, 1.5rem);
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .room-code {
        font-size: clamp(1.75rem, 4vw, 3.5rem);
        font-weight: 700;
        letter-spacing: 0.1em;
        font-variant-numeric: tabular-nums;
      }

      .countdown-banner {
        margin: 0;
        padding: 0.75rem clamp(1rem, 3vw, 3rem);
        background: color-mix(in srgb, var(--danger) 20%, var(--surface));
        color: var(--text);
        font-size: clamp(1rem, 1.8vw, 1.5rem);
        font-weight: 600;
        text-align: center;
        font-variant-numeric: tabular-nums;
      }

      .rung-toggle:disabled {
        cursor: not-allowed;
        opacity: 0.8;
      }

      .ladder {
        flex: 1;
        display: flex;
        flex-direction: column-reverse;
        justify-content: center;
        gap: clamp(0.75rem, 1.5vh, 1.25rem);
        padding: clamp(1rem, 3vh, 2.5rem) clamp(1rem, 4vw, 4rem);
        max-width: 72rem;
        margin: 0 auto;
        width: 100%;
      }

      .rung {
        border-radius: 1rem;
        border: 2px solid var(--border);
        background: var(--surface);
        padding: clamp(0.75rem, 1.5vh, 1.25rem) clamp(1rem, 2vw, 1.75rem);
        transition: none;
      }

      .rung.is-open {
        border-color: var(--accent);
        background: var(--surface-raised);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 35%, transparent);
      }

      .rung.is-locked {
        opacity: 0.55;
      }

      .rung-toggle {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        background: none;
        border: none;
        padding: 0;
        min-height: var(--rung-height);
        text-align: left;
      }

      .rung-label {
        font-size: clamp(1.25rem, 2.6vw, 2.25rem);
        font-weight: 700;
      }

      .lock {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        width: clamp(1.75rem, 3.2vw, 2.5rem);
        font-size: clamp(1.1rem, 2vw, 1.75rem);
      }

      .rung-state {
        margin-left: auto;
        font-size: clamp(0.9rem, 1.4vw, 1.25rem);
        color: var(--text-dim);
      }

      .rung.is-open .rung-state::after {
        content: "Open · accepting cards";
        color: var(--accent);
      }

      .rung.is-locked .rung-state::after {
        content: "locked";
      }

      .cards {
        list-style: none;
        margin: 0.75rem 0 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .card-chip {
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        padding: 0.5rem 0.75rem;
        font-size: clamp(0.95rem, 1.3vw, 1.2rem);
        max-width: 28rem;
      }

      .card-author {
        display: block;
        font-size: 0.75em;
        font-weight: 600;
        color: var(--text-dim);
        margin-bottom: 0.2rem;
      }

      .empty {
        color: var(--text-dim);
        font-size: clamp(0.9rem, 1.2vw, 1.1rem);
        font-style: italic;
      }

      @media (prefers-reduced-motion: no-preference) {
        .rung {
          transition:
            border-color 0.2s ease,
            opacity 0.2s ease;
        }
      }
    </style>
  </body>
</html>
